<span id="cb5-14">        new_centers <span class="op" style="color: #5E5E5E;
background-color: null;
font-style: inherit;">=</span> np.array([X[labels <span class="op" style="color: #5E5E5E;
background-color: null;
font-style: inherit;">==</span> i].mean(<span class="dv" style="color: #AD0000;
background-color: null;
font-style: inherit;">0</span>)</span>
<span id="cb5-15">                                <span class="cf" style="color: #003B4F;
